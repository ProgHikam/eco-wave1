# ECO-WAVE - pengamanan tingkat root (Apache/XAMPP). Tanpa modul tambahan: semua blok memakai <IfModule>.

# 1) Jangan tampilkan isi folder bila tidak ada index
Options -Indexes

# 2) Berkas yang tidak boleh diunduh lewat browser (SQL berisi kata sandi, dokumen internal, skrip, backup)
<FilesMatch "\.(sql|md|csv|py|js\.map|log|bak|old|ini|txt|zip|gz|tar|example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(requirements\.txt|README\.txt|\.htaccess|\.gitignore)$">
  Require all denied
</FilesMatch>

# 3) Folder internal
RedirectMatch 404 ^/(?:[^/]+/)?(05_docs|01_raw|02_processed|03_arcgis|04_output|arsip|scripts|tests)(/|$)

# 4) Header keamanan dasar
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# 5) PHP: jangan tampilkan galat ke pengunjung
<IfModule mod_php.c>
  php_flag display_errors off
  php_flag expose_php off
</IfModule>
